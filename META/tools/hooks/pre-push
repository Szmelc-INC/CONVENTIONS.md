#!/usr/bin/env bash
# Refuse to push local/* branches: private or unverified material that only
# leaves this machine after manual review (CONVENTIONS/workflow/branches.md).
# Enable once per clone: git config core.hooksPath META/tools/hooks
set -euo pipefail

status=0
while read -r local_ref _ remote_ref _; do
  if [[ $local_ref == refs/heads/local/* || $remote_ref == refs/heads/local/* ]]; then
    printf 'pre-push: refusing to push %s -> %s (local/* never leaves this machine)\n' "$local_ref" "$remote_ref" >&2
    status=1
  fi
done
exit "$status"
