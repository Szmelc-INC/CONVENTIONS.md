{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://szmelc-inc.github.io/CONVENTIONS.md/SPEC/schemas/index-v2.schema.json",
  "title": "Conventions Format 1.0 index v2",
  "type": "object",
  "required": ["format_version", "name", "repo", "entries", "compatible_disclaimer", "compatible"],
  "additionalProperties": false,
  "properties": {
    "$schema": {"type": "string", "format": "uri"},
    "format_version": {"const": "1.0"},
    "name": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
    "repo": {"type": "string", "format": "uri"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}},
    "compatible_disclaimer": {"type": "string"},
    "compatible": {"type": "array", "items": {"$ref": "compat-registry.schema.json#/$defs/record"}}
  },
  "$defs": {
    "entry": {
      "type": "object", "required": ["path", "title", "load_when", "status", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1},
        "load_when": {"type": "string", "minLength": 1}, "status": {"enum": ["always", "stable", "experimental", "legacy"]},
        "kind": {"enum": ["global", "core", "skill", "rule", "archive"]},
        "id": {"type": "string", "pattern": "^[a-z0-9]+([.-][a-z0-9]+)*$"},
        "origin": {"enum": ["third-party", "original"]}, "compat": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"kind": {"const": "rule"}}}, "then": {"required": ["id"]}}]
    }
  }
}
